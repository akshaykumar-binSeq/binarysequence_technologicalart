{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Index TOML parsed data",
  "type": "object",
  "required": [
    "system",
    "features"
  ],
  "properties": {
    "system": {
      "type": "object",
      "required": [
        "name",
        "version",
        "status"
      ]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "tier",
          "status",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FEAT-[0-9]{2}-[A-Z0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "in_development",
              "experimental",
              "available",
              "deferred",
              "retired"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public_route": {
            "type": "string"
          }
        }
      }
    }
  }
}